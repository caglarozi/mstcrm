{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      ".github/**",
      ".claude/**",
      ".firebase/**",
      ".gitignore",
      ".firebaserc",
      "PANEL-REKLAM-ENTEGRASYONU.md",
      "mcp-server/**",
      "*.log",
      "server.js",
      "package.json",
      "firestore.rules",
      "test-*.js",
      "_check.js",
      "whatsapp-webhook/**",
      "scripts/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
