rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Uygulamadaki sabit admin hesabı (admin@crm.com) — index.html içinde de
    // aynı e-posta özel olarak admin kabul ediliyor (bkz. setupAuthListener).
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@crm.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
      );
    }

    function isApproved() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
      );
    }

    // Kullanıcı kayıt / onay sistemi
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Kayıt olurken kullanıcı SADECE kendi dokümanını, daima
      // "personel" + onaysız olarak oluşturabilir. Admin yetkisi ya da
      // onay durumu asla kayıt anında client tarafından belirlenemez —
      // yalnızca mevcut bir admin sonradan bu alanları güncelleyebilir.
      // Sabit admin hesabının (admin@crm.com) normal kayıt akışından hiç
      // geçmediği için profili yoktur — ismini ilk kez kaydederken kendi
      // dokümanını role=admin/approved=true olarak oluşturabilmesi için
      // ayrı bir istisna var.
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'personel' && request.resource.data.approved == false) ||
        (isBootstrapAdmin() && request.resource.data.role == 'admin' && request.resource.data.approved == true)
      );

      // Kullanıcı kendi ad/kullanıcı adı/e-posta alanlarını güncelleyebilir
      // (Ayarlar > Hesabım), ama rol veya onay durumunu asla kendisi
      // değiştiremez — bunlar sadece admin tarafından değiştirilebilir.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approved == resource.data.approved
      );
      allow delete: if isAdmin();
    }

    // Eski tek-doküman CRM verisi (geçiş sürecinde yedek olarak tutuluyor)
    // ve personelin taşındığı küçük doküman (crm/staff)
    match /crm/{docId} {
      allow read, write: if isApproved();
    }

    // Yazarlar — her yazar artık kendi ayrı dokümanında (tek dev doküman
    // yerine). Taşıma script'i de bu koleksiyona yazdığı için bu kural
    // migration çalışmadan önce yayınlanmış olmalı.
    match /authors/{authorId} {
      allow read, write: if isApproved();
    }

    // Parçalara ayrılmış (chunked) dosya yüklemeleri
    match /crm_files/{chunkId} {
      allow read, write: if isApproved();
    }

    // Paket başına (vip/pro/standart) tek sözleşme şablonu — onaylı her
    // kullanıcı (Sözleşmeli Yazarlar ekranından) yükleyip indirebilir.
    match /packageContracts/{packageKey} {
      allow read, write: if isApproved();
    }

    // İşletme giderleri (ön muhasebe) — okuma/yazma yetkisi arayüz
    // tarafında admin/muhasebe rolüyle sınırlanıyor (Ödemeler sekmesiyle
    // aynı erişim kuralı), Firestore kuralı diğer koleksiyonlarla tutarlı
    // olsun diye onaylı her kullanıcıya izin veriyor.
    match /expenses/{expenseId} {
      allow read, write: if isApproved();
    }

    // Görevler — atama (oluşturma/atanan kişi değiştirme/silme) arayüz
    // tarafında admin ile sınırlanıyor, atanan kişi ise sadece kendi
    // görevini tamamlandı işaretleyip rapor yazabiliyor. Firestore kuralı
    // diğer koleksiyonlarla tutarlı olsun diye onaylı her kullanıcıya
    // izin veriyor (personel arasında hiyerarşi yok, incelik arayüzde).
    match /tasks/{taskId} {
      allow read, write: if isApproved();
    }

    // Stok/envanter — yazarlardan bağımsız kitap/ürün stok takibi.
    match /stock/{stockId} {
      allow read, write: if isApproved();
    }

    // Matbaa paneli — baskı siparişleri takibi.
    match /printOrders/{orderId} {
      allow read, write: if isApproved();
    }

    // Push bildirim abonelikleri — her onaylı kullanıcının cihazı kendi
    // FCM token'ını buraya yazar; worker görev atandığında bunları okuyup
    // (servis hesabıyla) push gönderir.
    match /fcm_tokens/{tokenId} {
      allow read, write: if isApproved();
    }

    // Linda sohbet geçmişi — her kullanıcı yalnızca KENDİ geçmişini okur/yazar
    // (doküman id'si = auth uid). Cihazlar arası sohbet sürekliliği için.
    match /chat_history/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // CRM -> yönetim paneli olay kuyruğu (örn. "sözleşme alındı").
    // CRM yalnızca olay OLUŞTURUR; okumayı/işaretlemeyi panel servis
    // hesabıyla yapar (servis hesabı bu kurallara tabi değildir).
    match /panel_events/{eventId} {
      allow create: if isApproved();
      allow read, update, delete: if false;
    }

    // Tanımlanmamış her şeyi varsayılan olarak reddet
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
